<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VICE VI : Neo Leonida — Open-World 3D Multijoueur & Mode Histoire</title>
  <meta name="description" content="Explorez Neo Leonida en 3D : Mode Histoire avec cinématiques, 5 missions, 8 véhicules pilotables, arsenal complet et serveur Multijoueur en temps réel." />
  
<style>
:root {
  --bg-deep: #090d16;
  --surface: rgba(12, 18, 30, 0.82);
  --surface-strong: rgba(10, 15, 25, 0.94);
  --border-subtle: rgba(255, 255, 255, 0.14);
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --coral: #ff5e5b;
  --amber: #f59e0b;
  --cyan: #00d2ff;
  --emerald: #22c55e;
  --danger: #ef4444;
  --font-display: Impact, 'Arial Narrow', 'Bebas Neue', system-ui, sans-serif;
  --font-ui: 'Bahnschrift', 'DIN Alternate', 'Segoe UI', system-ui, sans-serif;
  --font-body: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
}

html, body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--bg-deep);
  color: var(--text-main);
  font-family: var(--font-body);
}

#game-canvas {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  display: block;
}

.hidden {
  display: none !important;
}

#damage-vignette {
  position: fixed;
  inset: 0;
  pointer-events: none;
  box-shadow: inset 0 0 110px rgba(239, 68, 68, 0);
  transition: box-shadow 0.25s ease;
  z-index: 15;
}

#damage-vignette.hit {
  box-shadow: inset 0 0 140px rgba(239, 68, 68, 0.75);
}

/* ==================== TITLE SCREEN ==================== */
.title-screen {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
}

.title-backdrop {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.title-backdrop img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(1.1) contrast(1.06);
  transform: scale(1.03);
}

.title-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(9, 13, 22, 0.92) 0%,
    rgba(9, 13, 22, 0.72) 48%,
    rgba(9, 13, 22, 0.35) 100%
  );
}

.title-content {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1120px;
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
}

.brand-edition {
  display: inline-block;
  font-family: var(--font-ui);
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.26em;
  color: var(--amber);
  margin-bottom: 0.25rem;
}

.brand-title {
  font-family: var(--font-display);
  font-size: clamp(4.2rem, 8.5vw, 7rem);
  line-height: 0.92;
  letter-spacing: 0.06em;
  color: #ffffff;
  text-shadow: 0 10px 40px rgba(0, 0, 0, 0.65);
}

.brand-num {
  color: var(--coral);
}

.brand-sub {
  font-size: 1.05rem;
  color: #cbd5e1;
  max-width: 560px;
  margin-top: 0.4rem;
}

.launch-panel {
  max-width: 650px;
  background: var(--surface);
  backdrop-filter: blur(18px);
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
}

.player-setup-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.input-group label {
  font-family: var(--font-ui);
  font-size: 0.78rem;
  letter-spacing: 0.14em;
  color: var(--text-muted);
  font-weight: 700;
}

.input-group input,
.input-group select {
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 8px;
  color: var(--text-main);
  padding: 0.65rem 0.85rem;
  font-family: var(--font-body);
  font-size: 0.92rem;
  outline: none;
  user-select: text;
}

.input-group input:focus,
.input-group select:focus {
  border-color: var(--cyan);
}

.launch-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
}

.launch-actions button {
  text-align: left;
  padding: 0.95rem 1.2rem;
  border-radius: 10px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 0.18rem;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.launch-actions button:hover {
  transform: translateY(-2px);
}

.btn-primary {
  background: linear-gradient(135deg, #ff5e5b 0%, #ea580c 100%);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #ffffff;
}

.btn-secondary {
  background: linear-gradient(135deg, #0284c7 0%, #0e7490 100%);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.btn-ghost {
  background: rgba(30, 41, 59, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.14);
  color: #f8fafc;
}

.btn-title {
  font-family: var(--font-ui);
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.btn-desc {
  font-size: 0.82rem;
  opacity: 0.88;
}

.controls-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem 1.1rem;
  font-size: 0.78rem;
  color: var(--text-muted);
  padding-top: 0.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.09);
}

.controls-legend b {
  color: #f8fafc;
  font-weight: 600;
}

/* ==================== IN-GAME HUD ==================== */
.hud {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 20;
}

.hud-top-left {
  position: absolute;
  top: 16px;
  left: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  width: 320px;
  pointer-events: auto;
}

.online-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--surface);
  backdrop-filter: blur(10px);
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  padding: 6px 10px;
  font-family: var(--font-ui);
  font-size: 0.86rem;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--emerald);
}

.hud-mini-btn {
  margin-left: auto;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 0.76rem;
  letter-spacing: 0.08em;
  padding: 3px 8px;
  border-radius: 5px;
  cursor: pointer;
}

.hud-mini-btn:hover {
  background: rgba(255, 255, 255, 0.22);
}

.chat-box {
  background: rgba(9, 13, 22, 0.58);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  padding: 8px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.chat-messages {
  max-height: 112px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 0.78rem;
  line-height: 1.35;
}

.chat-line b {
  font-weight: 700;
  margin-right: 4px;
}

.chat-form input {
  width: 100%;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 5px;
  color: #ffffff;
  font-size: 0.78rem;
  padding: 5px 8px;
  outline: none;
  user-select: text;
}

.chat-form input:focus {
  border-color: var(--cyan);
}

.hud-top-center {
  position: absolute;
  top: 16px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  max-width: 560px;
}

.objective-bar {
  background: rgba(10, 15, 26, 0.85);
  border-left: 3px solid var(--amber);
  border-radius: 6px;
  padding: 8px 16px;
  font-family: var(--font-ui);
  font-size: 0.98rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: #fef3c7;
  text-align: center;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.toast-container {
  display: flex;
  flex-direction: column;
  gap: 5px;
  align-items: center;
}

.toast-item {
  background: rgba(15, 23, 42, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.16);
  padding: 6px 14px;
  border-radius: 6px;
  font-size: 0.84rem;
  font-weight: 500;
  color: #f8fafc;
  animation: fadeSlide 0.25s ease;
}

@keyframes fadeSlide {
  from { opacity: 0; transform: translateY(-6px); }
  to { opacity: 1; transform: translateY(0); }
}

.hud-top-right {
  position: absolute;
  top: 16px;
  right: 18px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}

.money-display {
  font-family: var(--font-display);
  font-size: 2.3rem;
  letter-spacing: 0.05em;
  color: #4ade80;
  text-shadow: 0 3px 12px rgba(0, 0, 0, 0.75);
  line-height: 1;
}

.wanted-stars {
  font-size: 1.35rem;
  letter-spacing: 4px;
  color: #facc15;
  text-shadow: 0 0 10px rgba(239, 68, 68, 0.7);
  min-height: 24px;
}

.weapon-card {
  background: var(--surface);
  backdrop-filter: blur(8px);
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  padding: 6px 12px;
  text-align: right;
  min-width: 155px;
}

.weapon-name {
  font-family: var(--font-ui);
  font-size: 0.92rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: #f8fafc;
}

.weapon-ammo {
  font-family: var(--font-ui);
  font-size: 0.85rem;
  color: var(--amber);
  font-weight: 700;
}

.radio-badge {
  background: rgba(10, 15, 25, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 6px;
  padding: 4px 10px;
  font-family: var(--font-ui);
  font-size: 0.78rem;
  font-weight: 700;
  display: flex;
  gap: 6px;
  align-items: center;
}

.radio-tag {
  color: var(--cyan);
}

.crosshair {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ch-ring {
  position: absolute;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 1.5px solid rgba(255, 255, 255, 0.45);
}

.ch-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 0 4px rgba(0, 0, 0, 0.95);
}

.hitmarker {
  position: absolute;
  font-size: 24px;
  font-weight: 700;
  color: #ff5e5b;
  opacity: 0;
  transform: scale(0.8);
  transition: opacity 0.08s ease, transform 0.08s ease;
  text-shadow: 0 0 8px rgba(255, 94, 91, 0.9);
}

.hitmarker.active {
  opacity: 1;
  transform: scale(1.15);
}

.interact-prompt {
  position: absolute;
  bottom: 120px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(9, 13, 22, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 8px;
  padding: 8px 16px;
  font-family: var(--font-ui);
  font-size: 0.98rem;
  font-weight: 700;
  letter-spacing: 0.06em;
}

.hud-bottom-left {
  position: absolute;
  bottom: 18px;
  left: 18px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.district-tag {
  font-family: var(--font-ui);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #f8fafc;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
}

.minimap-frame {
  width: 210px;
  height: 210px;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid rgba(255, 255, 255, 0.24);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);
  background: #0f172a;
}

.vitals-bars {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  width: 210px;
}

.vital-track {
  height: 7px;
  background: rgba(15, 23, 42, 0.85);
  border-radius: 4px;
  overflow: hidden;
}

.vital-fill {
  height: 100%;
  transition: width 0.12s linear;
}

.fill-health { background: #22c55e; }
.fill-armor { background: #38bdf8; }

.speedo-panel {
  position: absolute;
  bottom: 18px;
  right: 18px;
  background: var(--surface);
  backdrop-filter: blur(10px);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  padding: 12px 16px;
  min-width: 190px;
  text-align: right;
}

.vehicle-title {
  font-family: var(--font-ui);
  font-size: 0.88rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--coral);
}

.speed-row {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  gap: 5px;
}

.speed-val {
  font-family: var(--font-display);
  font-size: 2.8rem;
  line-height: 1;
}

.speed-unit {
  font-family: var(--font-ui);
  font-size: 0.82rem;
  color: var(--text-muted);
  font-weight: 700;
}

.nitro-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 6px;
}

.nitro-label {
  font-family: var(--font-ui);
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--cyan);
}

.nitro-track {
  flex: 1;
  height: 6px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 4px;
  overflow: hidden;
}

.nitro-fill {
  height: 100%;
  background: linear-gradient(90deg, #0ea5e9, #00f0ff);
}

.vehicle-hint {
  margin-top: 6px;
  font-size: 0.7rem;
  color: var(--text-muted);
}

/* ==================== CINEMATIC LETTERBOX ==================== */
.cinematic-overlay {
  position: fixed;
  inset: 0;
  z-index: 30;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cinema-bar {
  background: #04060a;
  width: 100%;
  padding: 18px 28px;
  pointer-events: auto;
}

.cinema-bar.top {
  height: 11vh;
  min-height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cinema-bar.bottom {
  height: 15vh;
  min-height: 96px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cinema-tag {
  font-family: var(--font-ui);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: var(--amber);
}

.skip-btn {
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #ffffff;
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  padding: 6px 14px;
  border-radius: 6px;
  cursor: pointer;
}

.subtitle-box {
  max-width: 780px;
  text-align: center;
}

.cinema-speaker {
  font-family: var(--font-ui);
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: var(--coral);
  margin-bottom: 4px;
}

.cinema-text {
  font-size: 1.08rem;
  line-height: 1.45;
  color: #f8fafc;
}

/* ==================== MISSION BANNER ==================== */
.mission-banner {
  position: fixed;
  top: 28%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 35;
  background: rgba(9, 13, 22, 0.92);
  border-top: 3px solid var(--amber);
  border-bottom: 3px solid var(--amber);
  padding: 22px 54px;
  text-align: center;
  pointer-events: none;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
}

.banner-title {
  font-family: var(--font-display);
  font-size: 3.4rem;
  letter-spacing: 0.08em;
  color: var(--amber);
}

.banner-sub {
  font-family: var(--font-ui);
  font-size: 1.45rem;
  font-weight: 700;
  color: #4ade80;
}

/* ==================== LEONIDA OS SMARTPHONE ==================== */
.phone-overlay {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 45;
}

.phone-device {
  width: 370px;
  max-height: 82vh;
  background: var(--surface-strong);
  backdrop-filter: blur(20px);
  border: 2px solid rgba(255, 255, 255, 0.2);
  border-radius: 22px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 28px 70px rgba(0, 0, 0, 0.72);
}

.phone-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  background: rgba(255, 255, 255, 0.04);
  border-bottom: 1px solid var(--border-subtle);
}

.phone-brand {
  font-family: var(--font-ui);
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: var(--cyan);
}

.phone-close {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 1.1rem;
  cursor: pointer;
}

.phone-tabs {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  border-bottom: 1px solid var(--border-subtle);
}

.phone-tab {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-family: var(--font-ui);
  font-size: 0.8rem;
  font-weight: 700;
  padding: 10px 4px;
  cursor: pointer;
  border-bottom: 2px solid transparent;
}

.phone-tab.active {
  color: #ffffff;
  border-bottom-color: var(--coral);
  background: rgba(255, 255, 255, 0.04);
}

.phone-body {
  padding: 14px;
  overflow-y: auto;
  flex: 1;
}

.tab-pane {
  display: none;
  flex-direction: column;
  gap: 10px;
}

.tab-pane.active {
  display: flex;
}

.phone-section-label {
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--text-muted);
  margin-top: 4px;
}

.phone-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.phone-card {
  background: rgba(30, 41, 59, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  cursor: pointer;
  text-align: left;
  color: var(--text-main);
  transition: background 0.15s ease, border-color 0.15s ease;
}

.phone-card:hover {
  background: rgba(51, 65, 85, 0.85);
  border-color: var(--cyan);
}

.phone-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 0.95rem;
}

.phone-card-meta {
  font-size: 0.76rem;
  color: var(--text-muted);
  line-height: 1.35;
}

.reward-tag {
  color: #4ade80;
  font-size: 0.82rem;
}

.vehicles-grid,
.weather-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.weather-btn,
.veh-btn {
  background: rgba(30, 41, 59, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 8px;
  color: #f8fafc;
  padding: 9px 10px;
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 0.84rem;
  cursor: pointer;
  text-align: left;
}

.weather-btn:hover,
.veh-btn:hover {
  border-color: var(--coral);
  background: rgba(51, 65, 85, 0.9);
}

.paint-swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.swatch-btn {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.35);
  cursor: pointer;
}

.phone-action-btn {
  width: 100%;
  background: linear-gradient(135deg, #0284c7, #0e7490);
  border: none;
  border-radius: 8px;
  color: #ffffff;
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 0.9rem;
  letter-spacing: 0.06em;
  padding: 10px 12px;
  cursor: pointer;
}

.phone-action-btn.danger {
  background: rgba(220, 38, 38, 0.78);
}

.room-switch-row {
  display: flex;
  gap: 8px;
}

.room-switch-row input {
  flex: 1;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 8px;
  color: #ffffff;
  padding: 8px 10px;
  user-select: text;
}

.room-switch-row button {
  width: auto;
  padding: 8px 14px;
}

.phone-tip {
  font-size: 0.75rem;
  color: var(--text-muted);
  line-height: 1.4;
}

</style>
</head>
<body>
  <canvas id="game-canvas"></canvas>
  <div id="damage-vignette"></div>

  <!-- MAIN TITLE / LAUNCH SCREEN -->
  <section id="title-screen" class="title-screen">
    <div class="title-backdrop">
      <img id="cover-img" src="data:image/jpeg;base64," alt="VICE VI : Neo Leonida" />
      <div class="title-scrim"></div>
    </div>

    <div class="title-content">
      <div class="brand-lockup">
        <span class="brand-edition">NEO LEONIDA • OPEN-WORLD 3D</span>
        <h1 class="brand-title">VICE <span class="brand-num">VI</span></h1>
        <p class="brand-sub">Mode Histoire avec Cinématiques 3D • Multijoueur Temps Réel • Ville Ouverte</p>
      </div>

      <div class="launch-panel">
        <div class="player-setup-row">
          <div class="input-group">
            <label for="player-name-input">PSEUDO EN LIGNE</label>
            <input id="player-name-input" type="text" maxlength="20" value="ViceRunner" placeholder="Ton pseudo..." />
          </div>
          <div class="input-group">
            <label for="room-select">SALON MULTIJOUEUR</label>
            <select id="room-select">
              <option value="neo-leonida-1">Neo Leonida #1 (Public)</option>
              <option value="starlight-drift">Starlight Drift & Courses</option>
              <option value="vice-pvp">Vice Warzone PvP</option>
            </select>
          </div>
        </div>

        <div class="launch-actions">
          <button id="btn-play-story" class="btn-primary">
            <span class="btn-title">MODE HISTOIRE</span>
            <span class="btn-desc">5 Missions • Cinématiques 3D • Braquage & Finale</span>
          </button>
          <button id="btn-play-online" class="btn-secondary">
            <span class="btn-title">MULTIJOUEUR ONLINE</span>
            <span class="btn-desc">Serveur WebSocket Live • Chat & Free-Roam</span>
          </button>
          <button id="btn-play-freeroam" class="btn-ghost">
            <span class="btn-title">EXPLORATION LIBRE</span>
            <span class="btn-desc">Voitures, Hélico, Bateaux, Armes & Police 5★</span>
          </button>
        </div>

        <div class="controls-legend">
          <span><b>ZQSD / WASD</b> Déplacer & Conduire</span>
          <span><b>E / F</b> Monter / Voler véhicule</span>
          <span><b>Shift</b> Sprint / Nitro</span>
          <span><b>Espace</b> Saut / Drift / Monter Hélico</span>
          <span><b>Clic Gauche</b> Tirer / Roquettes</span>
          <span><b>1–6</b> Armes</span>
          <span><b>Tab</b> Téléphone (Missions, Garage, Météo)</span>
          <span><b>R</b> Radio FM</span>
          <span><b>C</b> Caméra</span>
        </div>
      </div>
    </div>
  </section>

  <!-- IN-GAME HUD -->
  <div id="hud" class="hud hidden">
    <!-- Top Left: Online Status & Live Multiplayer Chat -->
    <div class="hud-top-left">
      <div class="online-pill">
        <span id="online-dot" class="status-dot"></span>
        <span id="online-label">ONLINE • 5 joueurs</span>
        <button id="btn-open-phone" class="hud-mini-btn" title="Ouvrir Téléphone (Tab)">TÉLÉPHONE [TAB]</button>
      </div>
      <div id="chat-box" class="chat-box">
        <div id="chat-messages" class="chat-messages"></div>
        <form id="chat-form" class="chat-form">
          <input id="chat-input" type="text" maxlength="160" placeholder="Touche T pour discuter..." />
        </form>
      </div>
    </div>

    <!-- Top Center: Mission Objective & Notifications -->
    <div class="hud-top-center">
      <div id="objective-bar" class="objective-bar hidden"></div>
      <div id="toast-container" class="toast-container"></div>
    </div>

    <!-- Top Right: Money, Wanted Stars, Weapon & Radio -->
    <div class="hud-top-right">
      <div id="money-display" class="money-display">$35 000</div>
      <div id="wanted-stars" class="wanted-stars"></div>
      <div class="weapon-card">
        <div id="weapon-name" class="weapon-name">9mm Tactique</div>
        <div id="weapon-ammo" class="weapon-ammo">120</div>
      </div>
      <div class="radio-badge">
        <span class="radio-tag">FM [R]</span>
        <span id="radio-station">VICE SYNTH 88.6 FM</span>
      </div>
    </div>

    <!-- Center Crosshair & Interaction Prompt -->
    <div id="crosshair" class="crosshair">
      <span class="ch-ring"></span>
      <span class="ch-dot"></span>
      <span id="hitmarker" class="hitmarker">×</span>
    </div>
    <div id="interact-prompt" class="interact-prompt hidden"></div>

    <!-- Bottom Left: Rotating Radar Minimap & Vitals -->
    <div class="hud-bottom-left">
      <div class="district-tag" id="district-name">Ocean Boulevard & Vice Beach</div>
      <div class="minimap-frame">
        <canvas id="minimap-canvas" width="210" height="210"></canvas>
      </div>
      <div class="vitals-bars">
        <div class="vital-track"><div id="bar-health" class="vital-fill fill-health" style="width:100%"></div></div>
        <div class="vital-track"><div id="bar-armor" class="vital-fill fill-armor" style="width:50%"></div></div>
      </div>
    </div>

    <!-- Bottom Right: Vehicle Speedometer & Nitro -->
    <div id="speedo-panel" class="speedo-panel hidden">
      <div id="vehicle-title" class="vehicle-title">Vortex GT-6</div>
      <div class="speed-row">
        <span id="speed-val" class="speed-val">0</span>
        <span class="speed-unit">KM/H</span>
      </div>
      <div class="nitro-row">
        <span class="nitro-label">NITRO</span>
        <div class="nitro-track"><div id="bar-nitro" class="nitro-fill" style="width:100%"></div></div>
      </div>
      <div id="vehicle-hint" class="vehicle-hint">SHIFT Nitro • ESPACE Drift • C Caméra</div>
    </div>
  </div>

  <!-- REAL-TIME 3D CINEMATIC LETTERBOX OVERLAY -->
  <div id="cinematic-overlay" class="cinematic-overlay hidden">
    <div class="cinema-bar top">
      <span class="cinema-tag">CINÉMATIQUE • MODE HISTOIRE</span>
      <button id="btn-skip-cinematic" class="skip-btn">PASSER [ESPACE]</button>
    </div>
    <div class="cinema-bar bottom">
      <div class="subtitle-box">
        <div id="cinema-speaker" class="cinema-speaker"></div>
        <div id="cinema-text" class="cinema-text"></div>
      </div>
    </div>
  </div>

  <!-- DRAMATIC MISSION PASSED / WASTED BANNER -->
  <div id="mission-banner" class="mission-banner hidden">
    <div id="banner-title" class="banner-title">MISSION RÉUSSIE</div>
    <div id="banner-sub" class="banner-sub">+$20 000</div>
  </div>

  <!-- LEONIDA OS IN-GAME SMARTPHONE (TAB / P) -->
  <aside id="phone-overlay" class="phone-overlay hidden">
    <div class="phone-device">
      <div class="phone-header">
        <span class="phone-brand">LEONIDA OS VI</span>
        <button id="btn-close-phone" class="phone-close">✕</button>
      </div>

      <nav class="phone-tabs">
        <button class="phone-tab active" data-tab="missions">Histoire</button>
        <button class="phone-tab" data-tab="garage">Garage</button>
        <button class="phone-tab" data-tab="weapons">Armes</button>
        <button class="phone-tab" data-tab="world">Monde</button>
        <button class="phone-tab" data-tab="online">Online</button>
      </nav>

      <div class="phone-body">
        <!-- TAB 1: STORY MISSIONS -->
        <div id="tab-missions" class="tab-pane active">
          <div id="missions-list" class="phone-list"></div>
          <button id="btn-abort-mission" class="phone-action-btn danger">Quitter la mission en cours</button>
        </div>

        <!-- TAB 2: GARAGE & TUNING -->
        <div id="tab-garage" class="tab-pane">
          <div class="phone-section-label">LIVRAISON INSTANTANÉE DE VÉHICULES</div>
          <div id="vehicles-grid" class="vehicles-grid"></div>
          <div class="phone-section-label">PEINTURE MÉTALLISÉE (VÉHICULE ACTUEL)</div>
          <div id="paint-swatches" class="paint-swatches"></div>
        </div>

        <!-- TAB 3: ARMURERIE -->
        <div id="tab-weapons" class="tab-pane">
          <div class="phone-section-label">ÉQUIPEMENT & MUNITIONS</div>
          <div id="weapons-list" class="phone-list"></div>
          <button id="btn-buy-armor" class="phone-action-btn">Acheter Gilet Kevlar 100% ($1 500)</button>
          <button id="btn-refill-ammo" class="phone-action-btn">Recharger toutes les munitions ($2 000)</button>
        </div>

        <!-- TAB 4: MONDE, MÉTÉO & GPS -->
        <div id="tab-world" class="tab-pane">
          <div class="phone-section-label">MÉTÉO & AMBIANCE LUMINEUSE</div>
          <div class="weather-grid">
            <button class="weather-btn" data-weather="golden">Golden Hour</button>
            <button class="weather-btn" data-weather="noon">Soleil Midi</button>
            <button class="weather-btn" data-weather="midnight">Minuit Néon</button>
            <button class="weather-btn" data-weather="storm">Orage Tropical</button>
          </div>
          <div class="phone-section-label">TÉLÉPORTATION RAPIDE (GPS)</div>
          <div id="poi-grid" class="weather-grid"></div>
          <button id="btn-clear-wanted" class="phone-action-btn">Appeler Lester — Effacer Police ($5 000)</button>
        </div>

        <!-- TAB 5: MULTIJOUEUR -->
        <div id="tab-online" class="tab-pane">
          <div class="phone-section-label">JOUEURS DANS LA SESSION</div>
          <div id="online-players-list" class="phone-list"></div>
          <div class="phone-section-label">CHANGER DE SALON SERVEUR</div>
          <div class="room-switch-row">
            <input id="phone-room-input" type="text" value="neo-leonida-1" />
            <button id="btn-switch-room" class="phone-action-btn">Rejoindre</button>
          </div>
          <p class="phone-tip">Astuce : Ouvre un deuxième onglet sur cette même page pour tester le Multijoueur temps réel côte à côte !</p>
        </div>
      </div>
    </div>
  </aside>

<script>
(function(){var e=document.createElement(`style`);e.textContent=`:root{--bg-deep:#090d16;--surface:#0c121ed1;--surface-strong:#0a0f19f0;--border-subtle:#ffffff24;--text-main:#f8fafc;--text-muted:#94a3b8;--coral:#ff5e5b;--amber:#f59e0b;--cyan:#00d2ff;--emerald:#22c55e;--danger:#ef4444;--font-display:Impact, "Arial Narrow", "Bebas Neue", system-ui, sans-serif;--font-ui:"Bahnschrift", "DIN Alternate", "Segoe UI", system-ui, sans-serif;--font-body:system-ui, -apple-system, "Segoe UI", Roboto, sans-serif}*{box-sizing:border-box;-webkit-user-select:none;user-select:none;margin:0;padding:0}html,body{background:var(--bg-deep);width:100%;height:100%;color:var(--text-main);font-family:var(--font-body);overflow:hidden}#game-canvas{width:100vw;height:100vh;display:block;position:fixed;inset:0}.hidden{display:none!important}#damage-vignette{pointer-events:none;z-index:15;transition:box-shadow .25s;position:fixed;inset:0;box-shadow:inset 0 0 110px #ef444400}#damage-vignette.hit{box-shadow:inset 0 0 140px #ef4444bf}.title-screen{z-index:40;justify-content:center;align-items:center;padding:2rem;display:flex;position:fixed;inset:0}.title-backdrop{position:absolute;inset:0;overflow:hidden}.title-backdrop img{object-fit:cover;filter:saturate(1.1)contrast(1.06);width:100%;height:100%;transform:scale(1.03)}.title-scrim{background:linear-gradient(90deg,#090d16eb 0%,#090d16b8 48%,#090d1659 100%);position:absolute;inset:0}.title-content{z-index:2;flex-direction:column;gap:1.75rem;width:100%;max-width:1120px;display:flex;position:relative}.brand-edition{font-family:var(--font-ui);letter-spacing:.26em;color:var(--amber);margin-bottom:.25rem;font-size:.9rem;font-weight:700;display:inline-block}.brand-title{font-family:var(--font-display);letter-spacing:.06em;color:#fff;text-shadow:0 10px 40px #000000a6;font-size:clamp(4.2rem,8.5vw,7rem);line-height:.92}.brand-num{color:var(--coral)}.brand-sub{color:#cbd5e1;max-width:560px;margin-top:.4rem;font-size:1.05rem}.launch-panel{background:var(--surface);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);border:1px solid var(--border-subtle);border-radius:14px;flex-direction:column;gap:1.2rem;max-width:650px;padding:1.5rem;display:flex;box-shadow:0 24px 60px #0000008c}.player-setup-row{grid-template-columns:1fr 1fr;gap:1rem;display:grid}.input-group{flex-direction:column;gap:.35rem;display:flex}.input-group label{font-family:var(--font-ui);letter-spacing:.14em;color:var(--text-muted);font-size:.78rem;font-weight:700}.input-group input,.input-group select{color:var(--text-main);font-family:var(--font-body);-webkit-user-select:text;user-select:text;background:#0f172ae6;border:1px solid #ffffff29;border-radius:8px;outline:none;padding:.65rem .85rem;font-size:.92rem}.input-group input:focus,.input-group select:focus{border-color:var(--cyan)}.launch-actions{grid-template-columns:1fr;gap:.75rem;display:grid}.launch-actions button{text-align:left;cursor:pointer;border-radius:10px;flex-direction:column;gap:.18rem;padding:.95rem 1.2rem;transition:transform .15s,background .15s,border-color .15s;display:flex}.launch-actions button:hover{transform:translateY(-2px)}.btn-primary{color:#fff;background:linear-gradient(135deg,#ff5e5b 0%,#ea580c 100%);border:1px solid #ffffff40}.btn-secondary{color:#fff;background:linear-gradient(135deg,#0284c7 0%,#0e7490 100%);border:1px solid #fff3}.btn-ghost{color:#f8fafc;background:#1e293bbf;border:1px solid #ffffff24}.btn-title{font-family:var(--font-ui);letter-spacing:.08em;font-size:1.2rem;font-weight:700}.btn-desc{opacity:.88;font-size:.82rem}.controls-legend{color:var(--text-muted);border-top:1px solid #ffffff17;flex-wrap:wrap;gap:.55rem 1.1rem;padding-top:.5rem;font-size:.78rem;display:flex}.controls-legend b{color:#f8fafc;font-weight:600}.hud{pointer-events:none;z-index:20;position:fixed;inset:0}.hud-top-left{pointer-events:auto;flex-direction:column;gap:8px;width:320px;display:flex;position:absolute;top:16px;left:16px}.online-pill{background:var(--surface);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid var(--border-subtle);font-family:var(--font-ui);letter-spacing:.05em;border-radius:8px;align-items:center;gap:8px;padding:6px 10px;font-size:.86rem;font-weight:700;display:flex}.status-dot{background:var(--emerald);border-radius:50%;width:8px;height:8px}.hud-mini-btn{color:#fff;font-family:var(--font-ui);letter-spacing:.08em;cursor:pointer;background:#ffffff1a;border:1px solid #ffffff2e;border-radius:5px;margin-left:auto;padding:3px 8px;font-size:.76rem;font-weight:700}.hud-mini-btn:hover{background:#ffffff38}.chat-box{-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);background:#090d1694;border:1px solid #ffffff1a;border-radius:8px;flex-direction:column;gap:6px;padding:8px;display:flex}.chat-messages{flex-direction:column;gap:4px;max-height:112px;font-size:.78rem;line-height:1.35;display:flex;overflow-y:auto}.chat-line b{margin-right:4px;font-weight:700}.chat-form input{color:#fff;-webkit-user-select:text;user-select:text;background:#0f172ab3;border:1px solid #ffffff1f;border-radius:5px;outline:none;width:100%;padding:5px 8px;font-size:.78rem}.chat-form input:focus{border-color:var(--cyan)}.hud-top-center{flex-direction:column;align-items:center;gap:8px;max-width:560px;display:flex;position:absolute;top:16px;left:50%;transform:translate(-50%)}.objective-bar{border-left:3px solid var(--amber);font-family:var(--font-ui);letter-spacing:.04em;color:#fef3c7;text-align:center;background:#0a0f1ad9;border-radius:6px;padding:8px 16px;font-size:.98rem;font-weight:700;box-shadow:0 8px 24px #0006}.toast-container{flex-direction:column;align-items:center;gap:5px;display:flex}.toast-item{color:#f8fafc;background:#0f172ae0;border:1px solid #ffffff29;border-radius:6px;padding:6px 14px;font-size:.84rem;font-weight:500;animation:.25s fadeSlide}@keyframes fadeSlide{0%{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}.hud-top-right{flex-direction:column;align-items:flex-end;gap:6px;display:flex;position:absolute;top:16px;right:18px}.money-display{font-family:var(--font-display);letter-spacing:.05em;color:#4ade80;text-shadow:0 3px 12px #000000bf;font-size:2.3rem;line-height:1}.wanted-stars{letter-spacing:4px;color:#facc15;text-shadow:0 0 10px #ef4444b3;min-height:24px;font-size:1.35rem}.weapon-card{background:var(--surface);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:1px solid var(--border-subtle);text-align:right;border-radius:8px;min-width:155px;padding:6px 12px}.weapon-name{font-family:var(--font-ui);letter-spacing:.06em;color:#f8fafc;font-size:.92rem;font-weight:700}.weapon-ammo{font-family:var(--font-ui);color:var(--amber);font-size:.85rem;font-weight:700}.radio-badge{font-family:var(--font-ui);background:#0a0f19b8;border:1px solid #ffffff1f;border-radius:6px;align-items:center;gap:6px;padding:4px 10px;font-size:.78rem;font-weight:700;display:flex}.radio-tag{color:var(--cyan)}.crosshair{justify-content:center;align-items:center;width:28px;height:28px;display:flex;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)}.ch-ring{border:1.5px solid #ffffff73;border-radius:50%;width:20px;height:20px;position:absolute}.ch-dot{background:#fffffff2;border-radius:50%;width:4px;height:4px;box-shadow:0 0 4px #000000f2}.hitmarker{color:#ff5e5b;opacity:0;text-shadow:0 0 8px #ff5e5be6;font-size:24px;font-weight:700;transition:opacity 80ms,transform 80ms;position:absolute;transform:scale(.8)}.hitmarker.active{opacity:1;transform:scale(1.15)}.interact-prompt{font-family:var(--font-ui);letter-spacing:.06em;background:#090d16e0;border:1px solid #ffffff38;border-radius:8px;padding:8px 16px;font-size:.98rem;font-weight:700;position:absolute;bottom:120px;left:50%;transform:translate(-50%)}.hud-bottom-left{flex-direction:column;gap:6px;display:flex;position:absolute;bottom:18px;left:18px}.district-tag{font-family:var(--font-ui);letter-spacing:.1em;text-transform:uppercase;color:#f8fafc;text-shadow:0 2px 6px #000000e6;font-size:.82rem;font-weight:700}.minimap-frame{background:#0f172a;border:2px solid #ffffff3d;border-radius:12px;width:210px;height:210px;overflow:hidden;box-shadow:0 12px 30px #0009}.vitals-bars{grid-template-columns:1fr 1fr;gap:6px;width:210px;display:grid}.vital-track{background:#0f172ad9;border-radius:4px;height:7px;overflow:hidden}.vital-fill{height:100%;transition:width .12s linear}.fill-health{background:#22c55e}.fill-armor{background:#38bdf8}.speedo-panel{background:var(--surface);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid var(--border-subtle);text-align:right;border-radius:12px;min-width:190px;padding:12px 16px;position:absolute;bottom:18px;right:18px}.vehicle-title{font-family:var(--font-ui);letter-spacing:.1em;text-transform:uppercase;color:var(--coral);font-size:.88rem;font-weight:700}.speed-row{justify-content:flex-end;align-items:baseline;gap:5px;display:flex}.speed-val{font-family:var(--font-display);font-size:2.8rem;line-height:1}.speed-unit{font-family:var(--font-ui);color:var(--text-muted);font-size:.82rem;font-weight:700}.nitro-row{align-items:center;gap:8px;margin-top:6px;display:flex}.nitro-label{font-family:var(--font-ui);color:var(--cyan);font-size:.72rem;font-weight:700}.nitro-track{background:#ffffff1f;border-radius:4px;flex:1;height:6px;overflow:hidden}.nitro-fill{background:linear-gradient(90deg,#0ea5e9,#00f0ff);height:100%}.vehicle-hint{color:var(--text-muted);margin-top:6px;font-size:.7rem}.cinematic-overlay{z-index:30;pointer-events:none;flex-direction:column;justify-content:space-between;display:flex;position:fixed;inset:0}.cinema-bar{pointer-events:auto;background:#04060a;width:100%;padding:18px 28px}.cinema-bar.top{justify-content:space-between;align-items:center;height:11vh;min-height:64px;display:flex}.cinema-bar.bottom{justify-content:center;align-items:center;height:15vh;min-height:96px;display:flex}.cinema-tag{font-family:var(--font-ui);letter-spacing:.2em;color:var(--amber);font-size:.85rem;font-weight:700}